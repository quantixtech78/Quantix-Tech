# ---- Contact form email (SMTP) ----
# Fill these in .env.local (never commit real secrets).

# Your outgoing mail server. Examples:
#   Your domain mailbox:  mail.quantix-tech.com  (ask your host/cPanel)
#   Gmail:                smtp.gmail.com
#   Microsoft 365:        smtp.office365.com
SMTP_HOST=mail.quantix-tech.com

# 465 = SSL (set SMTP_SECURE=true) | 587 = STARTTLS (SMTP_SECURE=false)
SMTP_PORT=465
SMTP_SECURE=true

# The mailbox you authenticate as.
SMTP_USER=sales@quantix-tech.com
# For Gmail, this must be an App Password (not your normal password).
SMTP_PASS=your-mailbox-or-app-password

# Where submissions are delivered (the "specific email").
CONTACT_TO=sales@quantix-tech.com
# The From address. Usually must equal SMTP_USER or a mailbox you own.
CONTACT_FROM=sales@quantix-tech.com
